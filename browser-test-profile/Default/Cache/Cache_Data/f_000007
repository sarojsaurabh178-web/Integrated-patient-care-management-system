lor: var(--auth-bg);\r\n  color: var(--auth-text-main);\r\n  transition: background-color 0.25s ease, color 0.25s ease;\r\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\r\n}\r\n\r\n.main-auth-content {\r\n  padding: 0;\r\n  margin: 0;\r\n  width: 100%;\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n/* Top bar */\r\n.auth-top-bar {\r\n  background-color: var(--auth-surface);\r\n  border-bottom: 1px solid var(--auth-card-border);\r\n  padding: 0.75rem 1.5rem;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 40;\r\n}\r\n\r\n.auth-top-inner {\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.auth-top-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n  cursor: pointer;\r\n  user-select: none;\r\n}\r\n\r\n.auth-brand-glyph {\r\n  width: 38px;\r\n  height: 38px;\r\n  border-radius: 10px;\r\n  background: linear-gradient(135deg, #2563eb, #0284c7);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);\r\n}\r\n\r\n.auth-brand-text {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.auth-brand-title {\r\n  font-size: 1.15rem;\r\n  font-weight: 800;\r\n  letter-spacing: -0.02em;\r\n  color: var(--auth-text-main);\r\n  line-height: 1.2;\r\n}\r\n\r\n.auth-brand-tag {\r\n  font-size: 0.72rem;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  color: var(--auth-primary);\r\n}\r\n\r\n/* Split Body Container */\r\n.auth-split-wrapper {\r\n  display: flex;\r\n  flex: 1;\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  width: 100%;\r\n  padding: 2rem 1.5rem 3rem;\r\n  gap: 2.5rem;\r\n  align-items: stretch;\r\n}\r\n\r\n/* Left Hero Panel (Desktop) */\r\n.auth-hero-panel {\r\n  flex: 1 1 45%;\r\n  background: var(--auth-hero-gradient);\r\n  border-radius: 24px;\r\n  