-border);\r\n  border-radius: 20px;\r\n  box-shadow: var(--auth-card-shadow);\r\n  overflow: hidden;\r\n  transition: all 0.25s ease;\r\n}\r\n\r\n.auth-card-body {\r\n  padding: 2.25rem 2rem;\r\n}\r\n\r\n/* Card Header */\r\n.auth-card-header {\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.auth-badge-header {\r\n  margin-bottom: 0.75rem;\r\n}\r\n\r\n.badge-pill-primary {\r\n  display: inline-block;\r\n  font-size: 0.72rem;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  padding: 0.25rem 0.65rem;\r\n  background-color: var(--auth-primary-light);\r\n  color: var(--auth-primary);\r\n  border-radius: 9999px;\r\n}\r\n\r\n.badge-pill-success {\r\n  display: inline-block;\r\n  font-size: 0.72rem;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  padding: 0.25rem 0.65rem;\r\n  background-color: rgba(16, 185, 129, 0.15);\r\n  color: #10b981;\r\n  border-radius: 9999px;\r\n}\r\n\r\n.badge-pill-warning {\r\n  display: inline-block;\r\n  font-size: 0.72rem;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  padding: 0.25rem 0.65rem;\r\n  background-color: rgba(245, 158, 11, 0.15);\r\n  color: #f59e0b;\r\n  border-radius: 9999px;\r\n}\r\n\r\n.badge-pill-info {\r\n  display: inline-block;\r\n  font-size: 0.72rem;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  padding: 0.25rem 0.65rem;\r\n  background-color: rgba(14, 165, 233, 0.15);\r\n  color: #0ea5e9;\r\n  border-radius: 9999px;\r\n}\r\n\r\n.auth-main-title {\r\n  font-size: 1.6rem;\r\n  font-weight: 800;\r\n  letter-spacing: -0.02em;\r\n  color: var(--auth-text-main);\r\n  margin-bottom: 0.4rem;\r\n  line-height: 1.25;\r\n}\r\n\r\n.auth-main-subtitle {\r\n  font-size: 0.9rem;\r\n  line-height: 1.5;\r\n  color: var(--auth-text-secondary);\r\n  margin-bottom: 0;\r\n}\r\n\r\n/* Alert Boxes */\r\n.auth-alert {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 0.75rem;\r\n  padding: 0.85rem 1rem;\r\n  border-radius: 12px;\r\n  font-size: 0.86rem;\r\n  margin-bottom: 1.25rem;\r\n  line-height: 1.45;\r\n}\r\n\r\n.auth-alert-danger {\r\n  background-color: rgba(239, 68, 68, 0.12);\r\n  border: 1px solid rgba(239, 68, 68, 0.25);\r\n  color: #ef4444;\r\n}\r\n\r\n[data-theme=\"dark\"] .auth-alert-danger {\r\n  background-color: rgba(239, 68, 68, 0.18);\r\n  border-color: rgba(239, 68, 68, 0.35);\r\n  color: #fca5a5;\r\n}\r\n\r\n.auth-alert-success {\r\n  background-color: rgba(16, 185, 129, 0.12);\r\n  border: 1px solid rgba(16, 185, 129, 0.25);\r\n  color: #10b981;\r\n}\r\n\r\n[data-theme=\"dark\"] .auth-alert-success {\r\n  background-color: rgba(16, 185, 129, 0.18);\r\n  border-color: rgba(16, 185, 129, 0.35);\r\n  color: #6ee7b7;\r\n}\r\n\r\n/* Labels and Hint */\r\n.label-with-hint {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  margin-bottom: 0.35rem;\r\n}\r\n\r\n.auth-label {\r\n  font-size: 0.84rem;\r\n  font-weight: 600;\r\n  color: var(--auth-text-main);\r\n  margin-bottom: 0.35rem;\r\n  display: block;\r\n}\r\n\r\n.req-star {\r\n  color: #ef4444;\r\n  margin-left: 2px;\r\n}\r\n\r\n.type-detector-badge {\r\n  font-size: 0.72rem;\r\n  font-weight: 600;\r\n  padding: 0.15rem 0.5rem;\r\n  border-radius: 9999px;\r\n  animation: fadeIn 0.2s ease;\r\n}\r\n\r\n.type-detector-badge.email {\r\n  background-color: rgba(59, 130, 246, 0.15);\r\n  color: var(--auth-primary);\r\n}\r\n\r\n.type-detector-badge.phone {\r\n  background-color: rgba(16, 185, 129, 0.15);\r\n  color: #10b981;\r\n}\r\n\r\n.field-hint-text {\r\n  display: block;\r\n  font-size: 0.75rem;\r\n  color: var(--auth-text-muted);\r\n  margin-top: 0.35rem;\r\n  line-height: 1.35;\r\n}\r\n\r\n/* Input Group Wrappers */\r\n.auth-input-wrapper {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  width: 100%;\r\n}\r\n\r\n.input-prefix-icon {\r\n  position: absolute;\r\n  left: 0.85rem;\r\n  color: var(--auth-text-muted);\r\n  pointer-events: none;\r\n  display: flex;\r\n  align-items: center;\r\n  z-index: 2;\r\n}\r\n\r\n.input-suffix-btn {\r\n  position: absolute;\r\n  right: 0.75rem;\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--auth-text-muted);\r\n  cursor: pointer;\r\n  padding: 0.25rem;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 2;\r\n  transition: color 0.15s ease;\r\n}\r\n\r\n.input-suffix-btn:hover {\r\n  color: var(--auth-text-main);\r\n}\r\n\r\n/* Form Controls */\r\n.auth-input {\r\n  width: 100%;\r\n  height: 46px;\r\n  padding: 0.55rem 0.85rem;\r\n  font-size: 0.92rem;\r\n  background-color: var(--auth-input-bg);\r\n  border: 1px solid var(--auth-input-border);\r\n  border-radius: 10px;\r\n  color: var(--auth-text-main);\r\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;\r\n}\r\n\r\n.auth-input.with-prefix {\r\n  padding-left: 2.6rem;\r\n}\r\n\r\n.auth-input.with-suffix {\r\n  padding-right: 2.6rem;\r\n}\r\n\r\n.auth-input:focus {\r\n  background-color: var(--auth-card-bg);\r\n  border-color: var(--auth-input-border-focus);\r\n  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);\r\n  outline: none;\r\n  color: var(--auth-text-main);\r\n}\r\n\r\n.auth-input::placeholder {\r\n  color: var(--auth-text-muted);\r\n  opacity: 0.85;\r\n}\r\n\r\n.auth-input:disabled {\r\n  opacity: 0.65;\r\n  cursor: not-allowed;\r\n}\r\n\r\n/* 2-Column Responsive Form Row */\r\n.form-row-2col {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 1rem;\r\n}\r\n\r\n@media (max-width: 576px) {\r\n  .form-row-2col {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n/* Security Notice Box */\r\n.security-notice-box {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 0.5rem;\r\n  margin-top: 0.5rem;\r\n  padding: 0.55rem 0.75rem;\r\n  background-color: rgba(59, 130, 246, 0.08);\r\n  border: 1px solid rgba(59, 130, 246, 0.18);\r\n  border-radius: 8px;\r\n  font