\n  justify-content: center;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.stat-blue { background-color: var(--info-light); color: var(--info-color); }\r\n.stat-sky { background-color: var(--primary-light); color: var(--primary-color); }\r\n.stat-indigo { background-color: rgba(168, 85, 247, 0.15); color: #a855f7; }\r\n.stat-green { background-color: var(--secondary-light); color: var(--secondary-color); }\r\n\r\n.stat-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.stat-label {\r\n  font-size: 0.8rem;\r\n  font-weight: 600;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.stat-value {\r\n  font-size: 1.65rem;\r\n  font-weight: 800;\r\n  color: var(--text-primary);\r\n  line-height: 1.2;\r\n}\r\n\r\n.stat-trend {\r\n  font-size: 0.75rem;\r\n  color: var(--text-muted);\r\n  margin-top: 0.15rem;\r\n}\r\n\r\n.trend-up { color: var(--secondary-color); font-weight: 600; }\r\n.trend-neutral { color: var(--primary-color); font-weight: 500; }\r\n\r\n/* Quick Action Banner */\r\n.quick-actions-card {\r\n  background: linear-gradient(135deg, #0d6efd 0%, #0284c7 100%);\r\n  color: #ffffff;\r\n  border-radius: var(--radius-xl);\r\n  padding: 1.5rem 2rem;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  margin-bottom: 2rem;\r\n  box-shadow: var(--shadow-md);\r\n}\r\n\r\n[data-theme=\"dark\"] .quick-actions-card {\r\n  background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%);\r\n  border: 1px solid var(--primary-color);\r\n}\r\n\r\n.quick-actions-header h3 {\r\n  font-size: 1.2rem;\r\n  font-weight: 700;\r\n  color: #ffffff;\r\n}\r\n\r\n.quick-actions-header p {\r\n  font-size: 0.85rem;\r\n  opacity: 0.9;\r\n  color: #ffffff;\r\n}\r\n\r\n.quick-actions-btns {\r\n  display: flex;\r\n  gap: 1rem;\r\n}\r\n\r\n.action-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.6rem;\r\n  padding: 0.65rem 1.25rem;\r\n  border-radius: var(--radius-md);\r\n  font-size: 0.875rem;\r\n  font-weight: 600;\r\n  border: none;\r\n  cur